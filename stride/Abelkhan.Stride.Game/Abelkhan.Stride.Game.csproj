<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Abelkhan.Stride</RootNamespace>
    <AssemblyName>Abelkhan.Stride.Game</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="4.4.1" />
    <PackageReference Include="Stride.Video" Version="4.4.1" />
    <PackageReference Include="Stride.Physics" Version="4.4.1" />
    <PackageReference Include="Stride.Navigation" Version="4.4.1" />
    <PackageReference Include="Stride.Particles" Version="4.4.1" />
    <PackageReference Include="Stride.UI" Version="4.4.1" />
    <PackageReference Include="Stride.AssetCompiler" Version="4.4.1" IncludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- 帧客户端 SDK：协议封装 + 报文分发都在这里 -->
    <ProjectReference Include="..\..\client\client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game Studio 通过 .sdpkg 打开这个工程 -->
    <None Include="Abelkhan.Stride.Game.sdpkg" />
  </ItemGroup>

</Project>
