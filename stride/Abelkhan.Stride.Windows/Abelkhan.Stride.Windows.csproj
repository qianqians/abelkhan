<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Abelkhan.Stride.Windows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>..\Bin\Windows\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)..\Abelkhan.Stride.Game\Abelkhan.Stride.Game.sdpkg</StrideCurrentPackagePath>
    <StridePlatform>Windows</StridePlatform>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Abelkhan.Stride.Game\Abelkhan.Stride.Game.csproj" />
  </ItemGroup>
</Project>
